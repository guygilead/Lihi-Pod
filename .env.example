# ── Site ─────────────────────────────────────────────────────────────
# Production URL (used for canonical, sitemap, robots, OpenGraph).
NEXT_PUBLIC_SITE_URL=https://lihi-gilad.co.il

# ── Contact form email (server-side, via Resend) ─────────────────────
# Create a free key at https://resend.com and verify a sending domain.
# Until these are set, the form still "succeeds" and submissions are
# logged to the server console (see app/api/contact/route.ts).
RESEND_API_KEY=
# Inbox that receives the leads:
CONTACT_TO=hello@lihi-gilad.co.il
# Verified sender (defaults to Resend's onboarding address if unset):
CONTACT_FROM=Lihi Podcast <onboarding@resend.dev>
